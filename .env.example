# Optional Fastify port (default 3001).
PORT=3001
# Get the local database address from the Supabase CLI and export it for Prisma.
DATABASE_URL=
# Origin of the Supabase project serving the tokens (local example: http://127.0.0.1:54321).
SUPABASE_URL=
# Optional for asymmetric JWTs. Required for legacy HS256 token verification.
SUPABASE_PUBLISHABLE_KEY=
# Optional server-only legacy service role key for the private product photo bucket.
SUPABASE_SERVICE_ROLE_KEY=
# Optional origins for the web app and server-to-server API requests.
MIZAN_WEB_ORIGIN=http://127.0.0.1:3000
MIZAN_API_URL=http://127.0.0.1:3001
# Local Mailpit SMTP: smtp://127.0.0.1:54325
MIZAN_SMTP_URL=
MIZAN_INVITATION_FROM=
# Optional disposable localhost database for integration and milestone tests.
MIZAN_TEST_DATABASE_URL=
# Mailpit HTTP origin used to capture invitation links in the milestone suite.
MIZAN_TEST_MAILPIT_URL=http://127.0.0.1:54324
# Optional live Storage integration test configuration (server-side only).
MIZAN_TEST_STORAGE_ORIGIN=
MIZAN_TEST_STORAGE_SERVICE_ROLE_KEY=
VITE_API_BASE_URL=/api/v1
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
