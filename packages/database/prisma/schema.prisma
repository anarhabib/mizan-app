generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
  schemas  = ["mizan"]
}

enum Role {
  OWNER
  SALESPERSON

  @@schema("mizan")
}

enum ProductStatus {
  IN_STOCK
  SOLD

  @@schema("mizan")
}

enum ProductMetal {
  GOLD

  @@schema("mizan")
}

enum GemstoneOrigin {
  NATURAL
  LAB_GROWN
  SIMULATED
  UNKNOWN

  @@schema("mizan")
}

enum MovementKind {
  PRODUCT_ADDED
  PRODUCT_SOLD
  OLD_GOLD_RECEIVED

  @@schema("mizan")
}

enum GoldPriceKind {
  RETAIL_SELL
  SCRAP_BUY
  SCRAP_SELL

  @@schema("mizan")
}

enum GoldPriceMode {
  FIXED
  PERCENTAGE
  OFFSET

  @@schema("mizan")
}

model User {
  id          String                   @id @db.Uuid
  createdAt   DateTime                 @default(now())
  memberships OrganizationMembership[]
  initialWorkspace OwnerOnboarding?
  salespersonDisplaySessions SalespersonDisplaySession[]

  @@schema("mizan")
}

model SalespersonDisplaySession {
  sessionId String @id @db.Uuid
  userId    String @db.Uuid
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("mizan")
}

model Organization {
  id                                String                   @id @default(uuid()) @db.Uuid
  name                              String
  defaultCurrency                   String                   @db.Char(3)
  paymentCurrencies                 String[]                 @default([])
  salespersonCanViewAcquisitionCost Boolean                  @default(false)
  createdAt                         DateTime                 @default(now())
  memberships                       OrganizationMembership[]
  stores                            Store[]
  purities                          PurityGrade[]

  @@schema("mizan")
}

model Store {
  organizationId String            @db.Uuid
  id             String            @default(uuid()) @db.Uuid
  name           String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignments    StoreAssignment[]
  invitations    Invitation[]
  products       Product[]
  customers      Customer[]
  goldPriceRules StoreGoldPriceRule[]
  ownerOnboardings OwnerOnboarding[]

  @@id([organizationId, id])
  @@schema("mizan")
}

model OwnerOnboarding {
  userId         String @id @db.Uuid
  organizationId String @db.Uuid
  storeId        String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  store Store @relation(fields: [organizationId, storeId], references: [organizationId, id], onDelete: Restrict)

  @@schema("mizan")
}

model OrganizationMembership {
  organizationId String            @db.Uuid
  userId         String            @db.Uuid
  role           Role
  active         Boolean           @default(true)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignments    StoreAssignment[]
  invitations    Invitation[] @relation("InvitedBy")
  acceptedInvitations Invitation[] @relation("AcceptedBy")
  goldPriceRules StoreGoldPriceRule[]

  @@id([organizationId, userId])
  @@index([userId])
  @@schema("mizan")
}

model StoreAssignment {
  organizationId String                 @db.Uuid
  storeId        String                 @db.Uuid
  userId         String                 @db.Uuid
  active         Boolean                @default(true)
  store          Store                  @relation(fields: [organizationId, storeId], references: [organizationId, id], onDelete: Restrict)
  membership     OrganizationMembership @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Restrict)
  sales          Sale[]
  salePayments   SalePayment[]
  movements      InventoryMovement[]

  @@id([organizationId, storeId, userId])
  @@index([organizationId, userId])
  @@schema("mizan")
}

model Invitation {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @db.Uuid
  storeId        String                 @db.Uuid
  invitedById    String                 @db.Uuid
  email          String
  tokenDigest    String                 @unique
  createdAt      DateTime               @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  acceptedAt     DateTime?
  acceptedById   String? @db.Uuid
  store          Store                  @relation(fields: [organizationId, storeId], references: [organizationId, id], onDelete: Restrict)
  invitedBy      OrganizationMembership @relation("InvitedBy", fields: [organizationId, invitedById], references: [organizationId, userId], onDelete: Restrict)
  acceptedBy     OrganizationMembership? @relation("AcceptedBy", fields: [organizationId, acceptedById], references: [organizationId, userId], onDelete: Restrict)

  @@index([organizationId, storeId])
  @@index([organizationId, acceptedById])
  @@schema("mizan")
}

model PurityGrade {
  organizationId String        @db.Uuid
  value          Int
  active         Boolean       @default(true)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products       Product[]
  goldPriceRules StoreGoldPriceRule[]
  tradeIns       TradeIn[]

  @@id([organizationId, value])
  @@schema("mizan")
}

model OfficialExchangeRateSnapshot {
  source        String    @id
  effectiveDate DateTime? @db.Date
  retrievedAt   DateTime?
  attemptedAt   DateTime
  usd           Decimal?  @db.Decimal(20, 8)
  eur           Decimal?  @db.Decimal(20, 8)
  try           Decimal?  @db.Decimal(20, 8)

  @@schema("mizan")
}

model OfficialExchangeRateObservation {
  source        String
  effectiveDate DateTime @db.Date
  usd           Decimal  @db.Decimal(20, 8)
  eur           Decimal  @db.Decimal(20, 8)
  try           Decimal  @db.Decimal(20, 8)

  @@id([source, effectiveDate])
  @@schema("mizan")
}

model GoldMarketCache {
  source      String    @id
  attemptedAt DateTime
  retrievedAt DateTime?
  quoteId     String?   @db.Uuid
  quote       GoldMarketQuote? @relation(fields: [quoteId], references: [id], onDelete: Restrict)

  @@schema("mizan")
}

model GoldMarketQuote {
  id                  String   @id @default(uuid()) @db.Uuid
  source              String
  effectiveAt         DateTime
  firstRetrievedAt    DateTime?
  usdPerTroyOunce     Decimal  @db.Decimal(26, 12)
  usdAzn              Decimal  @db.Decimal(20, 8)
  exchangeDate        DateTime @db.Date
  aznPerGram          Decimal  @db.Decimal(22, 8)
  caches              GoldMarketCache[]
  goldPriceRules      StoreGoldPriceRule[]
  tradeIns            TradeIn[]

  @@unique([source, effectiveAt, usdPerTroyOunce, usdAzn, exchangeDate], map: "GoldMarketQuote_observation_key")
  @@schema("mizan")
}

model StoreGoldPriceRule {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  storeId        String  @db.Uuid
  purity         Int?
  actorId        String   @db.Uuid
  kind           GoldPriceKind
  mode           GoldPriceMode?
  value          Decimal? @db.Decimal(18, 4)
  effectiveAt    DateTime @default(now())
  marketQuoteId  String?  @db.Uuid
  previousId     String?  @db.Uuid
  grade          PurityGrade? @relation(fields: [organizationId, purity], references: [organizationId, value], onDelete: Restrict)
  actor          OrganizationMembership @relation(fields: [organizationId, actorId], references: [organizationId, userId], onDelete: Restrict)
  marketQuote    GoldMarketQuote? @relation(fields: [marketQuoteId], references: [id], onDelete: Restrict)
  store          Store @relation(fields: [organizationId, storeId], references: [organizationId, id], onDelete: Restrict)
  previous       StoreGoldPriceRule? @relation("GoldRuleVersions", fields: [organizationId, storeId, kind, previousId], references: [organizationId, storeId, kind, id], onDelete: Restrict)
  successors     StoreGoldPriceRule[] @relation("GoldRuleVersions")
  tradeIns       TradeIn[]

  @@unique([organizationId, storeId, id])
  @@unique([organizationId, storeId, kind, id], map: "StoreGoldPriceRule_version_key")
  @@index([organizationId, storeId, kind, purity, effectiveAt], map: "StoreGoldPriceRule_scope_idx")
  @@index([organizationId, storeId, effectiveAt, id], map: "StoreGoldPriceRule_history_idx")
  @@schema("mizan")
}

model Product {
  organizationId         String              @db.Uuid
  storeId                String              @db.Uuid
  id                     String              @default(uuid()) @db.Uuid
  code                   String
  name                   String
  category               String
  metalType              ProductMetal        @default(GOLD)
  purity                 Int
  weight                 Decimal             @db.Decimal(15, 3)
  netGoldWeight          Decimal?            @db.Decimal(15, 3)
  acquisitionCost        Decimal             @db.Decimal(20, 4)
  acquisitionCostPerGram Decimal?            @db.Decimal(35, 16)
  acquisitionCurrency    String              @db.Char(3)
  acquisitionMetal       Decimal?            @db.Decimal(20, 4)
  acquisitionGemstones   Decimal?            @db.Decimal(20, 4)
  acquisitionWorkmanship Decimal?            @db.Decimal(20, 4)
  acquisitionOther       Decimal?            @db.Decimal(20, 4)
  fixedSellingAmount     Decimal?            @db.Decimal(20, 4)
  fixedSellingCurrency   String?             @db.Char(3)
  photoObjectKey         String?
  photoContentType       String?
  photoSize              Int?
  note                   String?
  status                 ProductStatus       @default(IN_STOCK)
  createdAt              DateTime            @default(now())
  store                  Store               @relation(fields: [organizationId, storeId], references: [organizationId, id], onDelete: Restrict)
  grade                  PurityGrade         @relation(fields: [organizationId, purity], references: [organizationId, value], onDelete: Restrict)
  sale                   Sale?
  saleItem               SaleItem?
  movements              InventoryMovement[]
  gemstones              ProductGemstone[]

  @@id([organizationId, storeId, id])
  @@unique([organizationId, code])
  @@schema("mizan")
}

model ProductGemstone {
  organizationId   String         @db.Uuid
  storeId          String         @db.Uuid
  productId        String         @db.Uuid
  position         Int
  gemstoneType     String
  stoneCount       Int
  totalCarats      Decimal?       @db.Decimal(15, 5)
  individualCarats Decimal?       @db.Decimal(15, 5)
  origin           GemstoneOrigin @default(UNKNOWN)
  shape            String?
  color            String?
  clarity          String?
  cutGrade         String?
  treatment        String?
  laboratory       String?
  reportNumber     String?
  note             String?
  product          Product        @relation(fields: [organizationId, storeId, productId], references: [organizationId, storeId, id], onDelete: Cascade)

  @@id([organizationId, storeId, productId, position])
  @@schema("mizan")
}

model Customer {
  organizationId String   @db.Uuid
  storeId        String   @db.Uuid
  id             String   @default(uuid()) @db.Uuid
  name           String
  phone          String
  phoneDigits    String
  note           String?
  createdAt      DateTime @default(now())
  store          Store    @relation(fields: [organizationId, storeId], references: [organizationId, id], onDelete: Restrict)
  sales          Sale[]

  @@id([organizationId, storeId, id])
  @@index([organizationId, storeId, createdAt, id])
  @@schema("mizan")
}

model Sale {
  organizationId              String              @db.Uuid
  storeId                     String              @db.Uuid
  id                          String              @default(uuid()) @db.Uuid
  productId                   String              @db.Uuid
  customerId                  String?             @db.Uuid
  customerReportingRate       Decimal?            @db.Decimal(20, 8)
  actorId                     String              @db.Uuid
  idempotencyKey              String
  requestDigest               String
  currency                    String              @db.Char(3)
  defaultCurrency             String              @db.Char(3)
  exchangeRate                Decimal             @db.Decimal(24, 8)
  saleAmount                  Decimal             @db.Decimal(28, 4)
  defaultSaleAmount           Decimal             @db.Decimal(28, 4)
  acceptedTradeInTotal        Decimal             @db.Decimal(32, 15)
  defaultAcceptedTradeInTotal Decimal             @db.Decimal(32, 4)
  settlement                  Decimal             @db.Decimal(32, 4)
  defaultSettlement           Decimal             @db.Decimal(32, 4)
  paymentCurrency             String?             @db.Char(3)
  paymentAmount               Decimal?            @db.Decimal(28, 4)
  paymentExchangeRate         Decimal?            @db.Decimal(24, 8)
  convertedPayment            Decimal?            @db.Decimal(32, 4)
  changeAmount                Decimal?            @db.Decimal(32, 4)
  outstandingDebt             Decimal             @db.Decimal(32, 4)
  productCode                 String
  productName                 String
  productCategory             String
  productPurity               Int
  productWeight               Decimal             @db.Decimal(15, 3)
  createdAt                   DateTime            @default(now())
  product                     Product             @relation(fields: [organizationId, storeId, productId], references: [organizationId, storeId, id], onDelete: Restrict)
  customer                    Customer?           @relation(fields: [organizationId, storeId, customerId], references: [organizationId, storeId, id], onDelete: Restrict)
  actor                       StoreAssignment     @relation(fields: [organizationId, storeId, actorId], references: [organizationId, storeId, userId], onDelete: Restrict)
  tradeIns                    TradeIn[]
  items                       SaleItem[]
  payments                    SalePayment[]
  movements                   InventoryMovement[]

  @@id([organizationId, storeId, id])
  @@unique([organizationId, storeId, productId])
  @@unique([organizationId, storeId, actorId, idempotencyKey])
  @@index([organizationId, storeId, customerId, createdAt, id], map: "Sale_customer_history_idx")
  @@index([organizationId, storeId, createdAt, id], map: "Sale_dashboard_date_idx")
  @@schema("mizan")
}

model SalePayment {
  organizationId  String          @db.Uuid
  storeId         String          @db.Uuid
  saleId          String          @db.Uuid
  id              String          @default(uuid()) @db.Uuid
  actorId         String          @db.Uuid
  position        Int?
  idempotencyKey  String?
  requestDigest   String?
  method          String
  currency        String          @db.Char(3)
  amount          Decimal         @db.Decimal(28, 4)
  exchangeRate    Decimal         @db.Decimal(24, 8)
  amountAzn       Decimal         @db.Decimal(32, 2)
  convertedAmount Decimal         @db.Decimal(32, 4)
  createdAt       DateTime        @default(now())
  sale            Sale            @relation(fields: [organizationId, storeId, saleId], references: [organizationId, storeId, id], onDelete: Restrict)
  actor           StoreAssignment @relation(fields: [organizationId, storeId, actorId], references: [organizationId, storeId, userId], onDelete: Restrict)

  @@id([organizationId, storeId, id])
  @@unique([organizationId, storeId, saleId, position])
  @@unique([organizationId, storeId, saleId, actorId, idempotencyKey])
  @@index([organizationId, storeId, createdAt, id], map: "SalePayment_dashboard_date_idx")
  @@schema("mizan")
}

model SaleItem {
  organizationId         String   @db.Uuid
  storeId                String   @db.Uuid
  saleId                 String   @db.Uuid
  productId              String   @db.Uuid
  position               Int
  productCode            String
  productName            String
  productCategory        String
  productPurity          Int
  productWeight          Decimal  @db.Decimal(15, 3)
  saleAmount             Decimal  @db.Decimal(20, 4)
  acquisitionCost        Decimal? @db.Decimal(20, 4)
  acquisitionCostPerGram Decimal? @db.Decimal(35, 16)
  acquisitionCurrency    String?  @db.Char(3)
  sale                   Sale     @relation(fields: [organizationId, storeId, saleId], references: [organizationId, storeId, id], onDelete: Restrict)
  product                Product  @relation(fields: [organizationId, storeId, productId], references: [organizationId, storeId, id], onDelete: Restrict)

  @@id([organizationId, storeId, productId])
  @@unique([organizationId, storeId, saleId, position])
  @@schema("mizan")
}

model TradeIn {
  organizationId  String              @db.Uuid
  storeId         String              @db.Uuid
  id              String              @default(uuid()) @db.Uuid
  saleId          String              @db.Uuid
  storeGoldPriceRuleId String?        @db.Uuid
  goldMarketQuoteId String?           @db.Uuid
  purity          Int
  weight          Decimal             @db.Decimal(15, 3)
  appliedRate     Decimal?            @db.Decimal(18, 4)
  rateExchangeRate Decimal?           @db.Decimal(24, 8)
  calculatedValue Decimal?            @db.Decimal(32, 15)
  acceptedValue   Decimal             @db.Decimal(32, 15)
  overridden      Boolean
  sale            Sale                @relation(fields: [organizationId, storeId, saleId], references: [organizationId, storeId, id], onDelete: Restrict)
  grade           PurityGrade         @relation(fields: [organizationId, purity], references: [organizationId, value], onDelete: Restrict)
  storeGoldPriceRule StoreGoldPriceRule? @relation(fields: [organizationId, storeId, storeGoldPriceRuleId], references: [organizationId, storeId, id], onDelete: Restrict)
  goldMarketQuote GoldMarketQuote?    @relation(fields: [goldMarketQuoteId], references: [id], onDelete: Restrict)
  receivedAsset   ReceivedOldGold?
  movements       InventoryMovement[]

  @@id([organizationId, storeId, id])
  @@index([organizationId, storeId, saleId])
  @@schema("mizan")
}

model ReceivedOldGold {
  organizationId String   @db.Uuid
  storeId        String   @db.Uuid
  tradeInId      String   @db.Uuid
  receivedAt     DateTime @default(now())
  tradeIn        TradeIn  @relation(fields: [organizationId, storeId, tradeInId], references: [organizationId, storeId, id], onDelete: Restrict)

  @@id([organizationId, storeId, tradeInId])
  @@index([organizationId, storeId, receivedAt, tradeInId], map: "ReceivedOldGold_dashboard_date_idx")
  @@schema("mizan")
}

model InventoryMovement {
  organizationId String          @db.Uuid
  storeId        String          @db.Uuid
  id             String          @default(uuid()) @db.Uuid
  actorId        String          @db.Uuid
  kind           MovementKind
  productId      String?         @db.Uuid
  saleId         String?         @db.Uuid
  tradeInId      String?         @db.Uuid
  createdAt      DateTime        @default(now())
  actor          StoreAssignment @relation(fields: [organizationId, storeId, actorId], references: [organizationId, storeId, userId], onDelete: Restrict)
  product        Product?        @relation(fields: [organizationId, storeId, productId], references: [organizationId, storeId, id], onDelete: Restrict)
  sale           Sale?           @relation(fields: [organizationId, storeId, saleId], references: [organizationId, storeId, id], onDelete: Restrict)
  tradeIn        TradeIn?        @relation(fields: [organizationId, storeId, tradeInId], references: [organizationId, storeId, id], onDelete: Restrict)

  @@id([organizationId, storeId, id])
  @@index([organizationId, storeId, productId])
  @@index([organizationId, storeId, kind, createdAt, id], map: "InventoryMovement_dashboard_date_idx")
  @@schema("mizan")
}
